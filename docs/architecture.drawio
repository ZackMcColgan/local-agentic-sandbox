        <!-- Web UI Pod -->
        <mxCell id="21" value="&lt;b style='font-size: 14px; color: #38bdf8;'&gt;web-ui: Orchestrator Pod&lt;/b&gt;&lt;br/&gt;&lt;span style='color: #64748b; font-size: 11px;'&gt;Port 3000 (NodePort 30300)&lt;/span&gt;&lt;hr/&gt;• &lt;b style='color: #c084fc;'&gt;Tri-Mode Dispatcher:&lt;/b&gt; Auto | Flash | Pro&lt;br/&gt;• &lt;b style='color: #38bdf8;'&gt;Multimodal Vision:&lt;/b&gt; Gemma 4 Ingestion&lt;br/&gt;• &lt;b style='color: #34d399;'&gt;Persistence:&lt;/b&gt; Chat History (v1) in LocalStorage&lt;br/&gt;• &lt;b style='color: #fb7185;'&gt;OTEL Tracer SDK:&lt;/b&gt; Distributed Spans&lt;br/&gt;• &lt;b style='color: #38bdf8;'&gt;Lease:&lt;/b&gt; keep_alive = '24h' (Hot VRAM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#0ea5e9;fontColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="20">
          <mxGeometry x="380" y="45" width="420" height="190" as="geometry" />
        </mxCell>

        <!-- MCP Runner Pod -->
        <mxCell id="22" value="&lt;b style='font-size: 14px; color: #34d399;'&gt;mcp-runner: Tool Boundary&lt;/b&gt;&lt;br/&gt;&lt;span style='color: #a7f3d0; font-size: 10px;'&gt;ClusterIP: 8080 | uid: 10001 | read_only rootfs&lt;/span&gt;&lt;hr/&gt;&lt;b&gt;8 Autonomous Tools:&lt;/b&gt;&lt;br/&gt;• workspace_get_tree, read_file, write_file&lt;br/&gt;• workspace_grep (ReDoS complexity guard)&lt;br/&gt;• workspace_run_command (Isolated Bash)&lt;br/&gt;• git_status, git_checkout, git_commit (Argv-safe)&lt;br/&gt;• execute_sandboxed_python &amp;amp; Attestation&lt;br/&gt;&lt;br/&gt;&lt;span style='color: #6ee7b7; font-weight: bold;'&gt;NetworkPolicy: Zero Egress Deny-All&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;fontColor=#e2e8f0;align=left;spacingLeft=12;" vertex="1" parent="20">
