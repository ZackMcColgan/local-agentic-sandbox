        <mxCell id="2" value="&lt;b style='font-size: 20px; color: #0369a1;'&gt;local-agentic-sandbox: Autonomous Platform v2 Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='color: #475569; font-size: 13px;'&gt;Zero-Trust Kubernetes Topology | Air-Gapped Code Execution | Tri-Mode Dispatcher | OpenTelemetry&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
