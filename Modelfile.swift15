FROM hf.co/ukisai/Swift-1.5-Qwen3.8-27B-GGUF:Q3_K_M

TEMPLATE {{ .Prompt }}

# MTP speculative decoding — draft head predicts 3 tokens ahead
PARAMETER draft_num_predict 3

# Sampling parameters (match current swift-27b-mtp settings)
PARAMETER temperature 1
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
