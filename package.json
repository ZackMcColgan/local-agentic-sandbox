{
  "name": "local-agentic-sandbox-root",
  "version": "1.1.0",
  "private": true,
  "description": "Zero-trust air-gapped agentic sandbox orchestrating local LLMs and Model Context Protocol",
  "workspaces": [
    "mcp-server",
    "browser-mcp",
    "web-ui"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "test:gate": "node scripts/test-gate.js",
    "test:coverage": "npm run test:coverage --workspaces",
    "build": "npm run build --workspaces",
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "restart": "docker compose restart",
    "logs": "docker compose logs -f",
    "pull:primary": "docker compose run --rm --network egress-mesh ollama ollama pull swift-27b-mtp",
    "pull:subagent": "docker compose run --rm --network egress-mesh ollama ollama pull swift-27b-mtp",
    "pull:all": "npm run pull:primary && npm run pull:subagent",
    "verify:sec": "docker compose exec mcp-server id && docker compose exec browser-mcp id",
    "lan:bridge": "node scripts/lan-bridge.js",
    "dev:proxy": "node scripts/dev-proxy.js",
    "test:ui": "node scripts/test-ui-render.js",
    "deploy:cluster": "node scripts/deploy-cluster.js",
    "deploy:all": "node scripts/deploy-cluster.js all",
    "eval:memory": "node ./web-ui/node_modules/tsx/dist/cli.mjs scripts/eval-memory.js",
    "generate:svg": "node ./web-ui/node_modules/tsx/dist/cli.mjs scripts/drawio-to-svg.ts"
  },
  "overrides": {
    "brace-expansion": "^2.0.2",
    "pacote": "^22.0.0",
    "http-cache-semantics": "^4.3.0",
    "ip-address": "^10.7.4",
    "picomatch": "^4.0.7",
    "sigstore": "^5.0.0",
    "braces": "^3.0.3",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6",
    "sprintf-js": "^1.1.3"
  }
}
