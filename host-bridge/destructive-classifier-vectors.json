  {
    "tool": "host_run_powershell",
    "args": {
      "command": "[System.Management.Automation.ScriptBlock]::Create(\"del x.txt\").Invoke()"
    },
    "expectedDestructive": true,
    "description": "Bypass: fully-qualified ScriptBlock::Create().Invoke()"
  },
  {
    "tool": "host_run_powershell",
    "args": { "command": "powershell -Command \"Remove-Item ./build\"" },
