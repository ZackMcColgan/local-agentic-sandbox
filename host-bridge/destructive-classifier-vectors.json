  },
  {
    "tool": "host_run_powershell",
    "args": { "command": "& \"cmd\" /q /c \"erase C:\\\\temp\\\\x.txt\"" },
    "expectedDestructive": true,
    "description": "Bypass: quoted cmd indirection with /q before /c"
  },
  {
    "tool": "host_run_powershell",
    "args": { "command": "& \"powershell\" -EncodedCommand aABlAGwAbABvAA==" },
    "expectedDestructive": true,
